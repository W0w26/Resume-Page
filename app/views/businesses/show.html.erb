<h1>Reviews for <%= @business_name %></h1>

<% if flash[:alert] %>
  <div class="alert alert-danger">
    <%= flash[:alert] %>
  </div>
<% elsif @reviews.empty? %>
  <div class="alert alert-info">
    No reviews found for this business.
  </div>
<% else %>
  <ul>
    <% @reviews.each do |review| %>
      <li><%= review.comment %> - <%= review.star_rating %> stars</li>
    <% end %>
  </ul>
<% end %>
