<%= form_with url: google_calendars_path, method: :post, local: true do |form| %>
  <div class="form-group">
    <%= form.label :summary, "Event Title" %>
    <%= form.text_field :summary, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :location, "Location" %>
    <%= form.text_field :location, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :start_time, "Start Time" %>
    <%= form.datetime_local_field :start_time, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :end_time, "End Time" %>
    <%= form.datetime_local_field :end_time, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :attendees, "Attendees (comma separated emails)" %>
    <%= form.text_field :attendees, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :description, "Description" %>
    <%= form.text_area :description, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.submit "Create Event", class: "custom-link" %>
  </div>
<% end %>
