<h1>Upcoming Events</h1>

<table class="table">
  <thead>
  <tr>
    <th>Title</th>
    <th>Location</th>
    <th>Start Time</th>
    <th>End Time</th>
  </tr>
  </thead>
  <tbody>
  <% @events.each do |event| %>
    <tr>
      <td><%= event.summary %></td>
      <td><%= event.location %></td>
      <td><%= event.start.date_time %></td>
      <td><%= event.end.date_time %></td>
    </tr>
  <% end %>
  </tbody>
</table>

<h2>Create a New Event</h2>
<%= render 'form' %>